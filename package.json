{
  "name": "personal-website-cdk",
  "version": "0.1.0",
  "bin": {
    "personal-website-cdk": "build/bin/personal-website.js"
  },
  "scripts": {
    "build": "tsc",
    "watch": "tsc -w",
    "test": "jest --coverage",
    "cdk": "cdk",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "npm run format && npm run build && npm run test && npm run cdk diff",
    "deploy": "npm run build && npm run test && npm run cdk synth && npm run cdk deploy",
    "deployall": "npm run build && npm run test && npm run cdk synth && npm run cdk deploy -- --all"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.145",
    "@types/jest": "^29.5.12",
    "@types/jsonwebtoken": "^9.0.8",
    "@types/node": "22.5.4",
    "@types/pg": "^8.15.4",
    "@types/uuid": "^10.0.0",
    "aws-cdk": "^2.177.0",
    "esbuild": "^0.24.0",
    "jest": "^29.7.0",
    "joi": "^17.13.3",
    "prettier": "^3.3.3",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "~5.6.2"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.658.1",
    "@aws-sdk/client-s3": "^3.658.1",
    "@aws-sdk/client-secrets-manager": "^3.826.0",
    "@aws-sdk/lib-dynamodb": "^3.658.1",
    "@aws-sdk/s3-request-presigner": "^3.658.1",
    "aws-cdk-lib": "^2.177.0",
    "constructs": "^10.0.0",
    "jsonwebtoken": "^9.0.2",
    "jwks-rsa": "^3.1.0",
    "pg": "^8.16.0",
    "source-map-support": "^0.5.21",
    "uuid": "^10.0.0"
  }
}
